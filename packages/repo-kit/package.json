{
  "name": "@godcreator/gwb-repo-kit",
  "version": "0.2.3",
  "author": { "name": "godcreator" },
  "description": "仓侧守卫工具包（dev-only，装进各插件仓的 devDependencies）：自述守卫与插件守卫两份正本——各仓 tests/ 里只是照着它跑的薄壳。",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-devkit.git"
  },
  "keywords": ["gwb"]
}
