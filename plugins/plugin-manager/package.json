{
  "name": "@godcreator/gwb-plugin-manager",
  "version": "0.8.4",
  "author": {
    "name": "godcreator"
  },
  "description": "插件管理：安装、卸载、升级 home 里的插件与内核，增删启停 cordis.yml 条目，在 npm 源上搜索插件、增删第三方包源",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "//prepublishOnly": "发版前强制构建一次：pnpm check 只跑类型检查、lint 和测试，不构建，少了这条会把上一版的 dist 原样发出去",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.5.0"
  },
  "devDependencies": {
    "@cordisjs/plugin-include": "1.1.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@godcreator/gwb-commands": "^0.5.0",
    "@godcreator/gwb-data": "^0.1.6",
    "@godcreator/gwb-settings": "^0.3.2",
    "@godcreator/gwb-skills": "^0.4.4",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "gwb": {
    "provides": {
      "gwbPluginManager": {
        "summary": "只表示插件管理装了，值是 { contract }，上面没有方法",
        "usage": "要跟着插件管理一起加载、卸载时 inject 它；装包、改条目一律调用 plugin-manager.* 命令"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-devkit.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
