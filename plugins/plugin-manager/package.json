{
  "name": "@godcreator/gwb-plugin-manager",
  "version": "0.7.1",
  "author": {
    "name": "godcreator"
  },
  "description": "插件管理：管 home 里的包与 cordis.yml 条目——安装、卸载、查新版本、一键热升级、升内核、加删条目、启用停用、重新加载；找插件与配包源——在配好的 npm 源上搜索插件（包清单 keywords 里有 gwb-plugin 的包），往机器级 ~/.npmrc 增删第三方包源（scope 路由）。对外只有命令；服务 gwbPluginManager 只表示装了。skill 1 份；命令 17 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "//prepublishOnly": "发版前强制构建一次：pnpm check 只跑类型检查、lint 和测试，不构建，少了这条会把上一版的 dist 原样发出去",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.3.0"
  },
  "dependencies": {
    "@pnpm/exe.win32-x64": "12.4.2"
  },
  "devDependencies": {
    "@cordisjs/plugin-include": "1.0.5",
    "@cordisjs/plugin-loader": "1.0.0-rc.6",
    "@godcreator/gwb-commands": "^0.4.6",
    "@godcreator/gwb-data": "^0.1.6",
    "@godcreator/gwb-plugin-api": "^0.3.0",
    "@godcreator/gwb-repo-kit": "workspace:*",
    "@godcreator/gwb-settings": "^0.3.2",
    "@godcreator/gwb-skills": "^0.4.4",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "gwb": {
    "provides": {
      "gwbPluginManager": {
        "summary": "只表示插件管理装了，值是 { contract }，上面没有方法",
        "usage": "要跟着插件管理一起加载、卸载时 inject 它；装包、改条目一律调用 plugin-manager.* 命令"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-devkit.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
