{
  "name": "@godcreator/gwb-plugin-manager",
  "version": "0.12.0",
  "author": {
    "name": "godcreator"
  },
  "description": "插件管理：安装、卸载、升级 home 里的插件与内核，增删启停 cordis.yml 条目，在 npm 源上搜索插件、增删第三方包源",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "//prepublishOnly": "发版前强制构建一次：pnpm check 只跑类型检查、lint 和测试，不构建，少了这条会把上一版的 dist 原样发出去",
    "prepublishOnly": "pnpm build"
  },
  "//peerDependencies": "运行时从 home 里得到的东西：内核包、命令总线（命令都登记在它上面）；数据、设置、说明书三个插件经 ctx.inject 可选使用，写成 optional，没装不报",
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.6.0",
    "@godcreator/gwb-commands": "^0.5.0",
    "@godcreator/gwb-data": "^0.1.7",
    "@godcreator/gwb-settings": "^0.3.3",
    "@godcreator/gwb-skills": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-data": { "optional": true },
    "@godcreator/gwb-settings": { "optional": true },
    "@godcreator/gwb-skills": { "optional": true }
  },
  "//devDependencies": "gwb-plugin-api 只为命令插件 0.5.0 的类型声明：它的 .d.ts 还从词汇表包取 GwbResult，缺了 commandBus.run 的回执成了 error 类型、lint 不过；命令插件改成从内核包取类型后删掉",
  "devDependencies": {
    "@cordisjs/plugin-include": "1.1.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@godcreator/gwb-plugin-api": "^0.4.1",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-devkit.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
