{
  "name": "@godcreator/gwb-plugin-manager",
  "version": "0.15.2",
  "author": {
    "name": "godcreator"
  },
  "description": "插件管理：安装、卸载、升级 home 里的插件与内核，增删启停 cordis.yml 条目，在配好的 npm 源上搜索插件",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./receipts": {
      "types": "./dist/receipts.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.10",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-skills": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-settings": { "optional": true },
    "@godcreator/gwb-skills": { "optional": true }
  },
  "devDependencies": {
    "@cordisjs/plugin-include": "1.1.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/gwb-lifecycle-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
