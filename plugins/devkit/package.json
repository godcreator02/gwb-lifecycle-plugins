{
  "name": "@godcreator/gwb-devkit",
  "version": "0.18.12",
  "author": {
    "name": "godcreator"
  },
  "description": "开发套件：建仓与往 workspace 仓加插件、结构体检、开关隔离 home、把改动装进隔离 home 验证、发正式版，随包带写插件、发版与生态验收三份说明书",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "src",
    "template"
  ],
  "gwb": {
    "title": "开发套件"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "//dependencies": "建文档站的两条命令（docs-site.create / docfirst.attach）只按名字在命令总线上找——本包不依赖站点插件与 docfirst 插件的任何包，三者互不依赖",
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.4.0"
  },
  "devDependencies": {
    "@godcreator/gwb-plugin-api": "^0.4.0",
    "@godcreator/gwb-commands": "0.4.5",
    "@godcreator/gwb-node-cli": "0.4.5",
    "@godcreator/gwb-shell": "0.13.3",
    "@godcreator/gwb-skills": "0.4.3",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-devkit.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
