{
  "name": "@godcreator/gwb-devkit",
  "version": "0.20.0",
  "author": {
    "name": "godcreator"
  },
  "description": "开发套件：建仓与往 workspace 仓加插件、开关隔离 home、列出 home 里的服务、把改动装进隔离 home 验证、发正式版，随包带写插件、发版与生态验收三份说明书",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "src",
    "template"
  ],
  "gwb": {
    "title": "开发套件"
  },
  "scripts": {
    "//build": "两步：esbuild 把 node 侧打成一个 dist/index.js（外置 node 内置模块、electron、cordis 与 peer 里的包，其余打包进去），tsc 只输出类型声明",
    "build": "node build.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "//dependencies": "建文档站的两条命令（docs-site.create / docfirst.attach）只按名字在命令总线上找——本包不依赖站点插件与 docfirst 插件的任何包，三者互不依赖",
  "//peerDependencies": "运行时从 home 里得到的东西：内核包、命令总线（inject 必需）、插件管理（import 它导出的 pnpm 定位、版本范围判定与命令名；devkit.dev 经它把开发版装进目标 home）；外壳、说明书、node 命令行三个插件经 ctx.inject 可选使用，写成 optional，没装不报",
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.6.0",
    "@godcreator/gwb-commands": "^0.5.0",
    "@godcreator/gwb-plugin-manager": "workspace:^",
    "@godcreator/gwb-node-cli": "^0.4.7",
    "@godcreator/gwb-shell": "^0.13.7",
    "@godcreator/gwb-skills": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-node-cli": { "optional": true },
    "@godcreator/gwb-shell": { "optional": true },
    "@godcreator/gwb-skills": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-devkit.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
