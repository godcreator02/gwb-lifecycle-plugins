{
  "name": "@godcreator/gwb-devkit",
  "version": "0.18.2",
  "author": {
    "name": "godcreator"
  },
  "description": "开发套件：建仓（scaffold）、往薄壳仓加件（scaffold.plugin）、结构体检（audit-structure）、测试 home 的开收、改一版看一版（devkit.dev）、发正式版（devkit.release）；随件带写件与发版两份手册。服务无；skill 3 份；命令 13 条。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "src",
    "template"
  ],
  "gwb": {
    "title": "开发套件"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "//dependencies": "站那半的两条命令（docs-site.create / docfirst.attach）只按名字在命令总线上找——本包不依赖站件与 docfirst 件的任何包，那正是三者互不依赖的判据",
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "@godcreator/gwb-shell": "^0.12.2"
  },
  "devDependencies": {
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-commands": "0.4.3",
    "@godcreator/gwb-node-cli": "0.4.3",
    "@godcreator/gwb-shell": "0.12.2",
    "@godcreator/gwb-skills": "0.4.1",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@godcreator/gwb-repo-kit": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-shell": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-devkit.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
