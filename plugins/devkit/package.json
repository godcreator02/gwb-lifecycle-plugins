{
  "name": "@godcreator/gwb-devkit",
  "version": "0.23.5",
  "author": {
    "name": "godcreator"
  },
  "description": "开发套件：建仓与往 workspace 仓加插件、开关隔离 home、把改动装进隔离 home 验证、发正式版，随包带写插件与发版两份说明书",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "src",
    "template"
  ],
  "publishConfig": { "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/" },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.7.0",
    "@godcreator/gwb-commands": "^0.5.0",
    "@godcreator/gwb-plugin-manager": "workspace:^",
    "@godcreator/gwb-node-cli": "^0.4.7",
    "@godcreator/gwb-shell": "^0.14.0",
    "@godcreator/gwb-skills": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-node-cli": { "optional": true },
    "@godcreator/gwb-shell": { "optional": true },
    "@godcreator/gwb-skills": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "es-module-lexer": "^2.3.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-devkit.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
