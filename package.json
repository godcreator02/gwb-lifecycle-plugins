{
  "name": "@godcreator02/gwb-devkit",
  "version": "0.0.5",
  "description": "开发套件：把一个新件的骨架落进一个新文件夹，并随件带一份写件手册",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "template",
    "skills"
  ],
  "gwb": {
    "title": "开发套件"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@godcreator02/gwb-plugin-api": ">=0.0.4"
  },
  "devDependencies": {
    "@godcreator02/gwb-plugin-api": "0.0.4",
    "@godcreator02/gwb-commands": "0.0.2",
    "@godcreator02/gwb-settings": "0.0.6",
    "@godcreator02/gwb-shell": "0.0.12",
    "@godcreator02/gwb-skills": "0.0.3",
    "@godcreator02/gwb-status": "0.0.4",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
