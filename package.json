{
  "name": "@godcreator02/gwb-devkit",
  "version": "0.1.0",
  "description": "开发套件：把一个新件的骨架落进一个新文件夹，随件带一份写件手册；本机源的起停与测试 home 的开/收也在这儿。0.1 对应单进程内核：注册窗格时自报浏览器半的 file:// 地址",
  "type": "module",
  "//exports": "只剩主入口。**内核不再读 exports 表**：浏览器半的地址由 node 半从 import.meta.url 算成 file://，注册窗格时报给外壳",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "template",
    "skills"
  ],
  "gwb": {
    "title": "开发套件"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@godcreator02/gwb-plugin-api": ">=0.1.0",
    "@godcreator02/gwb-shell": ">=0.1.0"
  },
  "devDependencies": {
    "@godcreator02/gwb-plugin-api": "0.1.0",
    "@godcreator02/gwb-commands": "0.1.0",
    "@godcreator02/gwb-settings": "0.1.0",
    "@godcreator02/gwb-shell": "0.1.0",
    "@godcreator02/gwb-skills": "0.1.0",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "@godcreator02/gwb-shell": {
      "optional": true
    }
  }
}
